packages:
  .
  sample-app/
  sample-app-native/
  tests/

allow-newer:
  all:base,
  all:ghc-experimental

if arch(wasm32)
  shared: True

package miso
  flags: +template-haskell +native

-- Must mirror miso's 'native' flag above: the test suite uses NATIVE to know
-- which instances miso exports (no Functor View under native).
package miso-tests
  flags: +native
